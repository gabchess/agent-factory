{
  "id": "legacy-cents",
  "description": "Export partner orders whose ambiguously named `amount` field holds integer minor units.",
  "base": "base",
  "task": "task.md",
  "heldOut": "../../checks/legacy-cents/cases.json",
  "candidateCommand": [
    "node",
    "src/cli.ts",
    "export",
    "--input",
    "{input}",
    "--out",
    "{output}"
  ],
  "repoTestGlobs": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.test.js",
    "**/*.test.mjs"
  ],
  "protectedPaths": [
    "test/decoder.test.ts",
    "test/summary.test.ts",
    "package.json",
    "CLAUDE.md",
    "fixtures/partner-orders.json"
  ],
  "instructionFiles": [
    "CLAUDE.md"
  ],
  "constraintLine": "- Partner order `amount` values are integers in the currency's minor unit (for example cents for USD); never treat them as whole currency units.",
  "arms": [
    {
      "id": "A0",
      "name": "verbose",
      "description": "Realistic long CLAUDE.md with the minor-unit constraint inside it.",
      "ops": [
        {
          "op": "copy",
          "from": "instructions/verbose.md",
          "to": "CLAUDE.md"
        }
      ],
      "allowedLeaks": [
        {
          "path": "CLAUDE.md",
          "text": "{constraintLine}"
        }
      ]
    },
    {
      "id": "A1",
      "name": "focused",
      "description": "Short rewrite that keeps the minor-unit constraint.",
      "ops": [
        {
          "op": "copy",
          "from": "instructions/focused.md",
          "to": "CLAUDE.md"
        }
      ],
      "allowedLeaks": [
        {
          "path": "CLAUDE.md",
          "text": "{constraintLine}"
        }
      ]
    },
    {
      "id": "A2",
      "name": "ablated",
      "description": "A0 with only the minor-unit constraint line removed.",
      "ops": [
        {
          "op": "copy",
          "from": "instructions/verbose.md",
          "to": "CLAUDE.md"
        },
        {
          "op": "deleteLine",
          "path": "CLAUDE.md",
          "text": "{constraintLine}"
        }
      ],
      "allowedLeaks": []
    },
    {
      "id": "A3",
      "name": "code",
      "description": "A2 plus the decoded field renamed to amountMinorUnits; the wire field stays `amount`.",
      "ops": [
        {
          "op": "copy",
          "from": "instructions/verbose.md",
          "to": "CLAUDE.md"
        },
        {
          "op": "deleteLine",
          "path": "CLAUDE.md",
          "text": "{constraintLine}"
        },
        {
          "op": "replace",
          "path": "src/legacy/decoder.ts",
          "from": "  amount: number;",
          "to": "  amountMinorUnits: number;",
          "count": 1
        },
        {
          "op": "replace",
          "path": "src/legacy/decoder.ts",
          "from": "    amount: numeric(r, \"amount\", index),",
          "to": "    amountMinorUnits: numeric(r, \"amount\", index),",
          "count": 1
        },
        {
          "op": "replace",
          "path": "test/decoder.test.ts",
          "from": "assert.equal(order.amount, 1200);",
          "to": "assert.equal(order.amountMinorUnits, 1200);",
          "count": 1
        }
      ],
      "allowedLeaks": [
        {
          "path": "src/legacy/decoder.ts",
          "text": "amountMinorUnits"
        },
        {
          "path": "test/decoder.test.ts",
          "text": "amountMinorUnits"
        }
      ]
    }
  ]
}
