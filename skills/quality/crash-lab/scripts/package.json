{
  "name": "agent-workflow-crash-lab",
  "version": "0.1.0",
  "description": "Tests whether changes to coding-agent instructions improve the work or quietly break it.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "bin": {
    "crashlab": "src/cli/main.ts"
  },
  "scripts": {
    "crashlab": "node src/cli/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint:comments": "node scripts/comment-ratchet.ts",
    "lint:comments:update": "node scripts/comment-ratchet.ts --update"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
